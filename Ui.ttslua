function Ui:slideAnimation(endOffsetXYZ, duration, easing)
    easing = easing or 'outQuad'

    local startOffsetX, startOffsetY, startOffsetZ = 0, 0, 0
    local endOffsetX, endOffsetY, endOffsetZ = 0, 0, 0

    if self.attributes.offsetXY == nil then
        startOffsetX, startOffsetY, startOffsetZ = (self.attributes.position or "0 0 0"):match("([%-]?%d+%.?%d*)%s+([%-]?%d+%.?%d*)%s+([%-]?%d+%.?%d*)")
        startOffsetX = tonumber(startOffsetX) or 0
        startOffsetY = tonumber(startOffsetY) or 0
        startOffsetZ = tonumber(startOffsetZ) or 0

        endOffsetX, endOffsetY, endOffsetZ = endOffsetXYZ:match("([%-]?%d+%.?%d*)%s+([%-]?%d+%.?%d*)%s+([%-]?%d+%.?%d*)")
        endOffsetX = tonumber(endOffsetX) or 0
        endOffsetY = tonumber(endOffsetY) or 0
        endOffsetZ = tonumber(endOffsetZ) or 0
    else
        startOffsetX, startOffsetY = (self.attributes.offsetXY or "0 0"):match("([%-]?%d+%.?%d*)%s+([%-]?%d+%.?%d*)")
        startOffsetX = tonumber(startOffsetX) or 0
        startOffsetY = tonumber(startOffsetY) or 0

        endOffsetX, endOffsetY = endOffsetXYZ:match("([%-]?%d+%.?%d*)%s+([%-]?%d+%.?%d*)")
        endOffsetX = tonumber(endOffsetX) or 0
        endOffsetY = tonumber(endOffsetY) or 0
    end

    local startTime = os.clock()

    local ease = {
        outQuad   = function(t) return t*(2-t) end,
        outCubic  = function(t) return 1 - (1 - t)^3 end,
        outQuint  = function(t) return 1 - (1 - t)^5 end,
        outExpo   = function(t) return (t==1) and 1 or 1 - 2^(-10*t) end,
        inQuint   = function(t) return t^5 end,
        inExpo    = function(t) return (t==0) and 0 or 2^(10*(t-1)) end,
        inOutSine = function(t) return 0.5 - 0.5*math.cos(math.pi*t) end,
        linear    = function(t) return t end,
    }

    local function step()
        local t = math.min((os.clock() - startTime) / duration, 1)
        local eased = ease[easing](t)
        local x = startOffsetX + (endOffsetX - startOffsetX) * eased
        local y = startOffsetY + (endOffsetY - startOffsetY) * eased
        local z = startOffsetZ + (endOffsetZ - startOffsetZ) * eased

        if self.attributes.offsetXY == nil then
            self:setPosition(string.format("%d %d %d", x, y, z))
        else
            self:setOffsetXY(string.format("%d %d", x, y))
        end
        
        if t < 1 then Wait.frames(step, 1) end
    end

    step()
end

function Ui.getRoot()
    return Ui.root
end

function Ui.getRootPerObject(object)
    if not object or object == Global then
        return Ui.getRoot()
    else
        return Ui.rootPerObject[object]
    end
end

function Ui:wipe()
    self.children = {}
    self.attributes = {}
    self:refresh()
end

function Ui:fullWipe()
    self:wipe()

    for _, root in pairs(self.rootPerObject) do
        root:wipe()
    end
end

function Ui.isUiLoading()
    if Ui.getRoot().object.UI.loading then
        return true
    else
        for _, root in pairs(Ui.rootPerObject) do
            if root.object.UI.loading then
                return true
            end
        end
    end

    return false
end

------------------------------------------------------

return {
    init = Ui.init,
    globalRefresh = Ui.globalRefresh,
    getRoot = Ui.getRoot,
    getRootPerObject = Ui.getRootPerObject,
    createRootOnObject = Ui.createRootOnObject,
    isUiLoading = Ui.isUiLoading,

    TRANSPARENT_INPUT_COLORS = Ui.TRANSPARENT_INPUT_COLORS,
    DEBUG_TRANSPARENT_INPUT_COLORS = Ui.DEBUG_TRANSPARENT_INPUT_COLORS,
    ANIMATION_LOCK_DELAY = Ui.ANIMATION_LOCK_DELAY,
    VISIBLE_COLORS = Ui.VISIBLE_COLORS,
    INVISIBLE_COLORS = Ui.INVISIBLE_COLORS,
}
